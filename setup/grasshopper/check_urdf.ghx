            <chunk name="Object" index="16">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math

config['bridge1_joint_EA_X'] = r1[0]
config['robot11_joint_EA_Y'] = r1[1]
config['robot11_joint_EA_Z'] = r1[2]

config['robot11_joint_1'] = math.radians(r1[5])
config['robot11_joint_2'] = math.radians(r1[6])
config['robot11_joint_3'] = math.radians(r1[7])
config['robot11_joint_4'] = math.radians(r1[8])
config['robot11_joint_5'] = math.radians(r1[9])
config['robot11_joint_6'] = math.radians(r1[10])

config['robot12_joint_EA_Y'] = r1[2]
config['robot12_joint_EA_Z'] = r1[4]

config['robot12_joint_1'] = math.radians(r1[5])
config['robot12_joint_2'] = math.radians(r1[6])
config['robot12_joint_3'] = math.radians(r1[7])
config['robot12_joint_4'] = math.radians(r1[8])
config['robot12_joint_5'] = math.radians(r1[9])
config['robot12_joint_6'] = math.radians(r1[10])



config['bridge2_joint_EA_X'] = r2[0]
config['robot21_joint_EA_Y'] = r2[1]
config['robot21_joint_EA_Z'] = r2[2]

config['robot21_joint_1'] = math.radians(r2[3])
config['robot21_joint_2'] = math.radians(r2[4])
config['robot21_joint_3'] = math.radians(r2[5])
config['robot21_joint_4'] = math.radians(r2[6])
config['robot21_joint_5'] = math.radians(r2[7])
config['robot21_joint_6'] = math.radians(r2[8])

config['robot22_joint_EA_Y'] = r2[9]
config['robot22_joint_EA_Z'] = r2[10]

config['robot22_joint_1'] = math.radians(r2[11])
config['robot22_joint_2'] = math.radians(r2[12])
config['robot22_joint_3'] = math.radians(r2[13])
config['robot22_joint_4'] = math.radians(r2[14])
config['robot22_joint_5'] = math.radians(r2[15])
config['robot22_joint_6'] = math.radians(r2[16])

print config</item>
