                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_ghpython.artists import RobotModelArtist
from compas_fab.robots import Robot

r = Robot(model)
r.artist = RobotModelArtist(model)

if zero_config:
    config = model.zero_configuration()
    print config
else:
    config = model.zero_configuration()
    config['r1_joint_1'] = 0
    config['r1_joint_2'] = 1
    config['r1_joint_3'] = -0.25
    config['r1_joint_4'] = 1
    config['r1_joint_5'] = -0.5
    config['r1_joint_6'] = 1

print config

artist = RobotModelArtist(model)
G = artist.draw_visual()

print r</item>
