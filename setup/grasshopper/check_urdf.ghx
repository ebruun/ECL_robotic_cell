                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.robots import LocalPackageMeshLoader
from compas.robots import RobotModel

model = RobotModel.from_urdf_file(urdf_filename)
print model
print path
print name

if load_geometry:
    
    loaders = [LocalPackageMeshLoader(path, name)]
    
    if name in ['abb_on_axis']:
        #loaders.append(LocalPackageMeshLoader(path, 'abb_irb4600_40_255'))
        pass
    elif name in ['princeton_2rob_cell']:
        loaders.append(LocalPackageMeshLoader(path, 'abb_irb4600_40_255'))
        loaders.append(LocalPackageMeshLoader(path, 'abb_on_axis'))
    elif name in ['princeton_3rob_cell']:
        loaders.append(LocalPackageMeshLoader(path, 'abb_irb4600_40_255'))
        loaders.append(LocalPackageMeshLoader(path, 'abb_irb7600_400_255'))
        loaders.append(LocalPackageMeshLoader(path, 'abb_on_axis'))
    elif name in ['rfl_description']:
        loaders.append(LocalPackageMeshLoader(path, 'abb_irb4600_40_255_RFL'))
        pass
        
    print(loaders)
    
    model.load_geometry(*loaders)

