              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math

print config

config['bridge1_joint_EA_X'] = r1[0]
config['robot1_joint_EA_Y'] = r1[1]
config['robot1_joint_EA_Z'] = r1[2]
config['robot1_joint_1'] = math.radians(r1[3])
config['robot1_joint_2'] = math.radians(r1[4])
config['robot1_joint_3'] = math.radians(r1[5])
config['robot1_joint_4'] = math.radians(r1[6])
config['robot1_joint_5'] = math.radians(r1[7])
config['robot1_joint_6'] = math.radians(r1[8])


config['bridge2_joint_EA_X'] = r1[9]
config['robot2_joint_EA_Y'] = r1[10]
config['robot2_joint_EA_Z'] = r1[11]
config['robot2_joint_1'] = math.radians(r1[12])
config['robot2_joint_2'] = math.radians(r1[13])
config['robot2_joint_3'] = math.radians(r1[14])
config['robot2_joint_4'] = math.radians(r1[15])
config['robot2_joint_5'] = math.radians(r1[16])
config['robot2_joint_6'] = math.radians(r1[17])

print config</item>
